<?xml version="1.0" encoding="utf-8" ?>
<Page x:ConnectionId='1'
    x:Class="Winspot_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Winspot_App.Models"
    mc:Ignorable="d">

    <Grid x:ConnectionId='2'
        Padding="20"
        ColumnSpacing="16"
                                   
        RowSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="360" />
            <ColumnDefinition Width="*" MinWidth="260" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox x:ConnectionId='3'
            x:Name="SearchBox"
            AutomationProperties.AutomationId="WinspotSearchBox"
            AutomationProperties.Name="Winspot search"
            FontSize="22"
            Grid.ColumnSpan="2"
            Header="Search"
            PlaceholderText="Search apps, files, commands, and plugins"
                                                                                              />

        <ListView x:ConnectionId='4'
            x:Name="ResultsList"
            Grid.Row="1"
            AutomationProperties.AutomationId="WinspotResultsList"
            AutomationProperties.Name="Search results"
            IsItemClickEnabled="True"
                                                                 
                                                                         >
            <ListView.ItemTemplate>
                <DataTemplate                                     >
                    <Grid x:ConnectionId='9' Padding="10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock x:ConnectionId='11' FontSize="16"                       />
                            <TextBlock x:ConnectionId='12'
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock x:ConnectionId='10'
                            Grid.Column="1"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                 />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Border
            Grid.Row="1"
            Grid.Column="1"
            Padding="14"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <ScrollViewer>
                <StackPanel Spacing="8">
                    <TextBlock x:ConnectionId='6'
                        AutomationProperties.AutomationId="WinspotPreviewTitle"
                        FontSize="16"
                        FontWeight="SemiBold"
                                                                                                    />
                    <TextBlock x:ConnectionId='7'
                        AutomationProperties.AutomationId="WinspotPreviewBody"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                                                                     
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <TextBlock x:ConnectionId='5'
            Grid.Row="2"
            Grid.ColumnSpan="2"
            AutomationProperties.AutomationId="WinspotStatusText"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                              />
    </Grid>
</Page>

