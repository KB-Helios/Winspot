<Window
    x:Class="Winspot_App.MainWindow"
    x:DataType="vm:LauncherViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Winspot_App.Models"
    xmlns:vm="using:Winspot_App.ViewModels"
    Title="Winspot"
    Width="760"
    Height="76"
    MinWidth="420"
    MinHeight="76"
    Background="Transparent"
    TransparencyLevelHint="Transparent"
    CanResize="False"
    ExtendClientAreaToDecorationsHint="True"
    ShowInTaskbar="False"
    WindowDecorations="None"
    Topmost="True"
    WindowStartupLocation="CenterScreen">
    <Window.Styles>
        <Style Selector="Border.spotlight-surface">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Border.search-shell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="58" />
            <Setter Property="Padding" Value="18,0" />
        </Style>

        <Style Selector="TextBox.query-box">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CaretBrush" Value="{DynamicResource CaretBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SelectionBrush" Value="{DynamicResource SelectionHighlightBrush}" />
        </Style>

        <!-- Hairline separators that divide the search field, results and footer. -->
        <Style Selector="Border.divider">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="16,0" />
            <Setter Property="Background" Value="{DynamicResource BorderInnerBrush}" />
        </Style>

        <Style Selector="ListBox.results-list">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
        </Style>

        <!-- Results reveal: fade + slide-up when the launcher expands. -->
        <Style Selector="Grid#ResultsHost">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="translateY(8px)" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Grid#ResultsHost.expanded">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="translateY(0px)" />
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style Selector="ListBoxItem /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        </Style>

        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
        </Style>

        <!-- Footer action hints: quiet, text-first chips with a soft key cap. -->
        <Style Selector="Border.action-chip">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderInnerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.action-chip:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        </Style>

        <Style Selector="Border.action-chip.focused">
            <Setter Property="Background" Value="{DynamicResource ChipFocusBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChipFocusBorderBrush}" />
        </Style>
    </Window.Styles>

    <Panel ClipToBounds="False">
        <Border
            x:Name="SpotlightSurface"
            Classes="spotlight-surface"
            Margin="8"
            Padding="0"
            Background="Transparent"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            BoxShadow="0 18 50 0 #80000000"
            ClipToBounds="True"
            CornerRadius="16">
            <Panel>
                <ExperimentalAcrylicBorder IsHitTestVisible="False" CornerRadius="16">
                    <ExperimentalAcrylicBorder.Material>
                        <ExperimentalAcrylicMaterial
                            BackgroundSource="Digger"
                            FallbackColor="{DynamicResource SurfaceColor}"
                            MaterialOpacity="0.85"
                            TintColor="{DynamicResource SurfaceTintColor}"
                            TintOpacity="1" />
                    </ExperimentalAcrylicBorder.Material>
                </ExperimentalAcrylicBorder>

                <Grid RowDefinitions="Auto,*">
                    <!-- Search field -->
                    <Border Classes="search-shell">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                FontSize="18"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="&#xE721;" />

                            <TextBox
                                x:Name="SearchBox"
                                Grid.Column="1"
                                Classes="query-box"
                                AutomationProperties.AutomationId="WinspotSearchBox"
                                AutomationProperties.Name="Winspot search"
                                Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Search apps, files, commands…" />

                            <Border
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                IsVisible="{Binding !IsExpanded}"
                                Background="{DynamicResource PanelElevatedBrush}"
                                CornerRadius="6"
                                Padding="8,3">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    Text="{Binding HotkeyHint}" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Expandable results region: divider, list, footer -->
                    <Grid
                        x:Name="ResultsHost"
                        Grid.Row="1"
                        Classes.expanded="{Binding IsExpanded}"
                        IsVisible="{Binding IsExpanded}"
                        RowDefinitions="Auto,*,Auto">
                        <Border Classes="divider" />

                        <ListBox
                            Grid.Row="1"
                            Classes="results-list"
                            AutomationProperties.AutomationId="WinspotResultsList"
                            AutomationProperties.Name="Search results"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ItemsSource="{Binding Results}"
                            SelectedItem="{Binding SelectedResult, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate
                                    DataType="models:SearchResultItem"
                                    x:DataType="models:SearchResultItem">
                                    <Grid
                                        MinHeight="48"
                                        ColumnDefinitions="Auto,*,Auto"
                                        ColumnSpacing="13"
                                        Margin="12,8">
                                        <Panel
                                            Width="26"
                                            Height="26"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                FontSize="18"
                                                Foreground="{DynamicResource IconForegroundBrush}"
                                                Text="{Binding IconGlyph}" />
                                            <Image
                                                Width="24"
                                                Height="24"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Source="{Binding IconPath, Converter={StaticResource IconPathToBitmap}}" />
                                        </Panel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock
                                                FontSize="14.5"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                Text="{Binding Title}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                Text="{Binding Subtitle}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{DynamicResource TextMutedBrush}"
                                            Text="{Binding Kind}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Footer: primary actions for the selected result + live status -->
                        <Border
                            Grid.Row="2"
                            BorderBrush="{DynamicResource BorderInnerBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="16,9">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <ItemsControl ItemsSource="{Binding SelectedActions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate
                                            DataType="models:ActionViewItem"
                                            x:DataType="models:ActionViewItem">
                                            <Border
                                                Classes="action-chip"
                                                Classes.focused="{Binding IsFocused}">
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                                    Text="{Binding Label}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="WinspotStatusText"
                                    FontSize="11.5"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    Text="{Binding StatusText}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Panel>
        </Border>
    </Panel>
</Window>
