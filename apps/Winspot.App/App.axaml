<Application
    x:Class="Winspot_App.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedThemeVariant="Dark">
    <Application.Styles>
        <SimpleTheme />
    </Application.Styles>
    <Application.Resources>
        <Color x:Key="SystemAccentColor">#9AB0CC</Color>
        <SolidColorBrush x:Key="SystemAccentColorBrush" Color="#9AB0CC" />
        <SolidColorBrush x:Key="SystemAccentColorDark1Brush" Color="#7F95B1" />
        <SolidColorBrush x:Key="SystemAccentColorDark2Brush" Color="#627894" />
        <SolidColorBrush x:Key="SystemAccentColorDark3Brush" Color="#45566E" />
        <SolidColorBrush x:Key="SystemAccentColorLight1Brush" Color="#B7C7DA" />
        <SolidColorBrush x:Key="SystemAccentColorLight2Brush" Color="#D4DEE9" />
        <SolidColorBrush x:Key="SystemAccentColorLight3Brush" Color="#EEF3F8" />
    </Application.Resources>
</Application>
