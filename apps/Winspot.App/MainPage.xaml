<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Winspot_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Winspot_App.Models"
    mc:Ignorable="d">

    <Grid
        Padding="12"
        ColumnSpacing="12"
        KeyDown="OnLauncherKeyDown"
        RowSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="360" />
            <ColumnDefinition Width="*" MinWidth="240" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox
            x:Name="SearchBox"
            AutomationProperties.AutomationId="WinspotSearchBox"
            AutomationProperties.Name="Winspot search"
            FontSize="18"
            Grid.ColumnSpan="2"
            MinHeight="40"
            PlaceholderText="Search apps, files, commands, and plugins"
            Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <ListView
            x:Name="ResultsList"
            Grid.Row="1"
            AutomationProperties.AutomationId="WinspotResultsList"
            AutomationProperties.Name="Search results"
            IsItemClickEnabled="True"
            ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
            SelectedItem="{x:Bind ViewModel.SelectedResult, Mode=TwoWay}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Margin" Value="0,0,0,2" />
                    <Setter Property="MinHeight" Value="44" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:SearchResultItem">
                    <Grid
                        MinHeight="44"
                        Padding="8,5"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="28"
                            Height="28"
                            VerticalAlignment="Center"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            CornerRadius="6">
                            <Grid>
                                <FontIcon
                                    AutomationProperties.Name="{x:Bind IconLabel}"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="14"
                                    Glyph="{x:Bind IconGlyph}" />
                                <Image
                                    Width="28"
                                    Height="28"
                                    AutomationProperties.AccessibilityView="Raw"
                                    Loaded="OnResultIconImageLoaded"
                                    Stretch="Uniform" />
                            </Grid>
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="0">
                            <TextBlock
                                FontSize="14"
                                Text="{x:Bind Title}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                MaxLines="1"
                                Text="{x:Bind Subtitle}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Kind}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Border
            Grid.Row="1"
            Grid.Column="1"
            Padding="10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <ScrollViewer>
                <StackPanel Spacing="6">
                    <TextBlock
                        AutomationProperties.AutomationId="WinspotPreviewTitle"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.PreviewTitle, Mode=OneWay}" />
                    <TextBlock
                        AutomationProperties.AutomationId="WinspotPreviewBody"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.PreviewBody, Mode=OneWay}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <TextBlock
            Grid.Row="2"
            Grid.ColumnSpan="2"
            AutomationProperties.AutomationId="WinspotStatusText"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
    </Grid>
</Page>
