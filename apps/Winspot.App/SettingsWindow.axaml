<Window
    x:Class="Winspot_App.SettingsWindow"
    x:DataType="vm:SettingsViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Winspot_App.ViewModels"
    Title="Winspot Settings"
    Width="460"
    Height="470"
    Background="{DynamicResource SurfaceBrush}"
    CanResize="False"
    WindowStartupLocation="CenterScreen">
    <Window.Styles>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderInnerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Window.Styles>

    <Grid Margin="20" RowDefinitions="Auto,*,Auto" RowSpacing="16">
        <TextBlock
            FontSize="20"
            FontWeight="SemiBold"
            Foreground="{DynamicResource TextPrimaryBrush}"
            Text="Settings" />

        <StackPanel Grid.Row="1" Spacing="16">
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Classes="section-title" Text="Activation hotkey" />
                    <WrapPanel>
                        <CheckBox Content="Ctrl" IsChecked="{Binding UseControl}" Margin="0,0,16,0" />
                        <CheckBox Content="Alt" IsChecked="{Binding UseAlt}" Margin="0,0,16,0" />
                        <CheckBox Content="Shift" IsChecked="{Binding UseShift}" Margin="0,0,16,0" />
                        <CheckBox Content="Win" IsChecked="{Binding UseWin}" />
                    </WrapPanel>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Text="Key" />
                        <TextBox
                            Grid.Column="1"
                            AutomationProperties.AutomationId="SettingsHotkeyKey"
                            MaxLength="12"
                            Text="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Space" />
                    </Grid>
                    <TextBlock Classes="hint" Text="{Binding HotkeyPreview, StringFormat='Current chord: {0}'}" />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Classes="section-title" Text="General" />
                    <CheckBox Content="Launch Winspot when I sign in" IsChecked="{Binding LaunchOnStartup}" />
                    <CheckBox Content="Show icon in the system tray" IsChecked="{Binding ShowTrayIcon}" />
                    <CheckBox Content="Reduce motion (minimize animations)" IsChecked="{Binding ReduceMotion}" />
                </StackPanel>
            </Border>

            <TextBlock
                Classes="hint"
                Foreground="{DynamicResource AccentBrush}"
                Text="{Binding StatusMessage}" />
        </StackPanel>

        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="10">
            <Button
                x:Name="CancelButton"
                Click="OnCancelClick"
                Content="Cancel"
                MinWidth="92" />
            <Button
                x:Name="SaveButton"
                Click="OnSaveClick"
                Content="Save"
                Foreground="{DynamicResource AccentForegroundBrush}"
                Background="{DynamicResource AccentBrush}"
                MinWidth="92" />
        </StackPanel>
    </Grid>
</Window>
