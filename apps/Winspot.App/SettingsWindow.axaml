<Window
    x:Class="Winspot_App.SettingsWindow"
    x:DataType="vm:SettingsViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Winspot_App.Controls"
    xmlns:vm="using:Winspot_App.ViewModels"
    Title="Winspot Settings"
    Width="720"
    Height="540"
    Background="{DynamicResource SurfaceBrush}"
    CanResize="False"
    WindowStartupLocation="CenterScreen">
    <Window.Styles>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderInnerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style Selector="Grid.setting-row">
            <Setter Property="MinHeight" Value="36" />
        </Style>
        <Style Selector="Button.icon-button">
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Window.Styles>

    <Grid Margin="18" RowDefinitions="Auto,*,Auto" RowSpacing="14">
        <!-- Branded header: spotlight badge + title + subtitle. -->
        <StackPanel Orientation="Horizontal" Spacing="14">
            <Border
                Width="42"
                Height="42"
                VerticalAlignment="Center"
                Background="{DynamicResource AccentGradientBrush}"
                CornerRadius="11">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                    FontSize="20"
                    Foreground="{DynamicResource AccentForegroundBrush}"
                    Text="&#xE721;" />
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="1">
                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Text="Winspot Settings" />
                <TextBlock
                    Classes="hint"
                    Text="Personalize search, motion, plugins and more" />
            </StackPanel>
        </StackPanel>

        <TabControl
            Grid.Row="1"
            SelectedIndex="{Binding SelectedSectionIndex}">
            <TabItem Header="General">
                <Border Classes="panel" Margin="0,10,0,0">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="section-title" Text="General" />
                        <CheckBox Content="Launch Winspot when I sign in" IsChecked="{Binding LaunchOnStartup}" />
                        <CheckBox Content="Show icon in the system tray" IsChecked="{Binding ShowTrayIcon}" />
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="Hotkey">
                <Border Classes="panel" Margin="0,10,0,0">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="section-title" Text="Activation hotkey" />
                        <WrapPanel>
                            <CheckBox Content="Ctrl" IsChecked="{Binding UseControl}" Margin="0,0,16,0" />
                            <CheckBox Content="Alt" IsChecked="{Binding UseAlt}" Margin="0,0,16,0" />
                            <CheckBox Content="Shift" IsChecked="{Binding UseShift}" Margin="0,0,16,0" />
                            <CheckBox Content="Win" IsChecked="{Binding UseWin}" />
                        </WrapPanel>
                        <Grid Classes="setting-row" ColumnDefinitions="210,*" ColumnSpacing="18" VerticalAlignment="Center">
                            <TextBlock Classes="label" VerticalAlignment="Center" Text="Key" />
                            <TextBox
                                Grid.Column="1"
                                AutomationProperties.AutomationId="SettingsHotkeyKey"
                                MaxLength="12"
                                Text="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Space" />
                        </Grid>
                        <TextBlock Classes="hint" Text="{Binding HotkeyPreview, StringFormat='Current chord: {0}'}" />
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="Appearance">
                <Border Classes="panel" Margin="0,10,0,0">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="section-title" Text="Appearance" />
                        <Grid Classes="setting-row" ColumnDefinitions="210,*" ColumnSpacing="18">
                            <TextBlock Classes="label" VerticalAlignment="Center" Text="Theme" />
                            <ComboBox
                                Grid.Column="1"
                                ItemsSource="{Binding ThemeModeOptions}"
                                SelectedItem="{Binding ThemeMode, Mode=TwoWay}" />
                        </Grid>
                        <Grid Classes="setting-row" ColumnDefinitions="210,*" ColumnSpacing="18">
                            <TextBlock Classes="label" VerticalAlignment="Center" Text="Motion" />
                            <ComboBox
                                Grid.Column="1"
                                ItemsSource="{Binding MotionProfileOptions}"
                                SelectedItem="{Binding MotionProfile, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="Plugins">
                <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <Border Classes="panel">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                    <StackPanel Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Classes="section-title" Text="Plugin validation" />
                                            <controls:SearchSpinner
                                                Width="14"
                                                Height="14"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="Validating plugins"
                                                IsVisible="{Binding IsPluginValidationRunning}" />
                                        </StackPanel>
                                        <TextBlock
                                            Classes="hint"
                                            Text="{Binding PluginValidationSummary}"
                                            TextWrapping="Wrap" />
                                        <TextBlock Classes="hint" Text="{Binding PluginValidationIssueSummary}" />
                                        <TextBlock Classes="hint" Text="{Binding PluginValidationLastCheckedText}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Click="OnValidatePluginsClick"
                                        Content="Validate"
                                        IsEnabled="{Binding !IsPluginValidationRunning}"
                                        MinWidth="92" />
                                    <Button
                                        Grid.Column="2"
                                        AutomationProperties.Name="Open plugins folder"
                                        Classes="icon-button"
                                        Click="OnOpenPluginsFolderClick"
                                        ToolTip.Tip="Open folder">
                                        <TextBlock
                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                            FontSize="15"
                                            Text="&#xE838;" />
                                    </Button>
                                </Grid>

                                <CheckBox
                                    Content="Show only manifests with issues"
                                    IsChecked="{Binding ShowOnlyPluginValidationIssues}" />
                            </StackPanel>
                        </Border>

                        <Border Classes="panel">
                            <StackPanel Spacing="12">
                                <TextBlock Classes="section-title" Text="Plugin folder" />
                                <Grid Classes="setting-row" ColumnDefinitions="210,*" ColumnSpacing="18">
                                    <TextBlock Classes="label" VerticalAlignment="Center" Text="Built-in" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Classes="hint"
                                        VerticalAlignment="Center"
                                        Text="{Binding BuiltInPluginsText}"
                                        TextWrapping="Wrap" />
                                </Grid>
                                <Grid Classes="setting-row" ColumnDefinitions="210,*" ColumnSpacing="18">
                                    <TextBlock Classes="label" VerticalAlignment="Center" Text="User manifests" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Classes="hint"
                                        VerticalAlignment="Center"
                                        Text="{Binding UserPluginManifestCountText}" />
                                </Grid>
                                <Grid ColumnDefinitions="210,*" ColumnSpacing="18">
                                    <TextBlock Classes="label" VerticalAlignment="Center" Text="Folder" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Classes="hint"
                                        VerticalAlignment="Center"
                                        Text="{Binding PluginsPath}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="panel">
                            <StackPanel Spacing="12">
                                <TextBlock Classes="section-title" Text="FastFlowLM" />
                                <CheckBox Content="Enable FastFlowLM" IsChecked="{Binding FastFlowLmEnabled}" />
                                <Grid Classes="setting-row" ColumnDefinitions="210,*" ColumnSpacing="18">
                                    <TextBlock Classes="label" VerticalAlignment="Center" Text="Model tag" />
                                    <TextBox
                                        Grid.Column="1"
                                        IsEnabled="{Binding FastFlowLmEnabled}"
                                        Text="{Binding FastFlowLmModelTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="gemma4-it:e2b" />
                                </Grid>
                                <Grid Classes="setting-row" ColumnDefinitions="210,*" ColumnSpacing="18">
                                    <TextBlock Classes="label" VerticalAlignment="Center" Text="Executable" />
                                    <TextBox
                                        Grid.Column="1"
                                        IsEnabled="{Binding FastFlowLmEnabled}"
                                        Text="{Binding FastFlowLmExecutablePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="flm" />
                                </Grid>
                                <Grid Classes="setting-row" ColumnDefinitions="210,*" ColumnSpacing="18">
                                    <TextBlock Classes="label" VerticalAlignment="Center" Text="Port" />
                                    <TextBox
                                        Grid.Column="1"
                                        IsEnabled="{Binding FastFlowLmEnabled}"
                                        MaxLength="5"
                                        Text="{Binding FastFlowLmPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="52625" />
                                </Grid>
                                <Grid Classes="setting-row" ColumnDefinitions="210,*" ColumnSpacing="18">
                                    <TextBlock Classes="label" VerticalAlignment="Center" Text="Idle timeout" />
                                    <TextBox
                                        Grid.Column="1"
                                        IsEnabled="{Binding FastFlowLmEnabled}"
                                        Text="{Binding FastFlowLmIdleTimeoutSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="120" />
                                </Grid>
                                <Grid Classes="setting-row" ColumnDefinitions="210,*" ColumnSpacing="18">
                                    <TextBlock Classes="label" VerticalAlignment="Center" Text="Context files" />
                                    <TextBox
                                        Grid.Column="1"
                                        IsEnabled="{Binding FastFlowLmEnabled}"
                                        Text="{Binding FastFlowLmMaxContextFiles, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="5" />
                                </Grid>
                                <Grid Classes="setting-row" ColumnDefinitions="210,*" ColumnSpacing="18">
                                    <TextBlock Classes="label" VerticalAlignment="Center" Text="File bytes" />
                                    <TextBox
                                        Grid.Column="1"
                                        IsEnabled="{Binding FastFlowLmEnabled}"
                                        Text="{Binding FastFlowLmMaxFileBytes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="1048576" />
                                </Grid>
                                <Grid Classes="setting-row" ColumnDefinitions="210,*" ColumnSpacing="18">
                                    <TextBlock Classes="label" VerticalAlignment="Center" Text="Context bytes" />
                                    <TextBox
                                        Grid.Column="1"
                                        IsEnabled="{Binding FastFlowLmEnabled}"
                                        Text="{Binding FastFlowLmMaxContextBytes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="4194304" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="panel">
                            <StackPanel Spacing="12">
                                <TextBlock Classes="section-title" Text="Windows Capture" />
                                <CheckBox Content="Enable Windows Capture" IsChecked="{Binding CaptureEnabled}" />
                                <Grid Classes="setting-row" ColumnDefinitions="210,*" ColumnSpacing="18">
                                    <TextBlock Classes="label" VerticalAlignment="Center" Text="Output folder" />
                                    <TextBox
                                        Grid.Column="1"
                                        IsEnabled="{Binding CaptureEnabled}"
                                        Text="{Binding CaptureOutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid Classes="setting-row" ColumnDefinitions="210,*" ColumnSpacing="18">
                                    <TextBlock Classes="label" VerticalAlignment="Center" Text="Default record seconds" />
                                    <TextBox
                                        Grid.Column="1"
                                        IsEnabled="{Binding CaptureEnabled}"
                                        MaxLength="3"
                                        Text="{Binding CaptureDefaultRecordSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="8" />
                                </Grid>
                                <Grid Classes="setting-row" ColumnDefinitions="210,*" ColumnSpacing="18">
                                    <TextBlock Classes="label" VerticalAlignment="Center" Text="Max record seconds" />
                                    <TextBox
                                        Grid.Column="1"
                                        IsEnabled="{Binding CaptureEnabled}"
                                        MaxLength="3"
                                        Text="{Binding CaptureMaxRecordSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="60" />
                                </Grid>
                                <CheckBox
                                    Content="Include cursor"
                                    IsChecked="{Binding CaptureIncludeCursor}"
                                    IsEnabled="{Binding CaptureEnabled}" />
                                <Grid Classes="setting-row" ColumnDefinitions="210,*" ColumnSpacing="18">
                                    <TextBlock Classes="label" VerticalAlignment="Center" Text="Pre-capture delay ms" />
                                    <TextBox
                                        Grid.Column="1"
                                        IsEnabled="{Binding CaptureEnabled}"
                                        MaxLength="4"
                                        Text="{Binding CapturePreCaptureDelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="250" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding PluginValidationEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:PluginValidationEntryViewItem" x:DataType="vm:PluginValidationEntryViewItem">
                                    <Border Classes="panel" Margin="0,0,0,8">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                                <TextBlock
                                                    Classes="label"
                                                    Text="{Binding DisplayName}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Classes="hint" Text="{Binding Status}" />
                                                <TextBlock Grid.Column="2" Classes="hint" Text="{Binding TrustSummary}" />
                                            </Grid>
                                            <TextBlock
                                                Classes="hint"
                                                Text="{Binding ManifestPath}"
                                                TextTrimming="CharacterEllipsis" />
                                            <ItemsControl ItemsSource="{Binding Issues}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="vm:PluginValidationIssueViewItem" x:DataType="vm:PluginValidationIssueViewItem">
                                                        <TextBlock
                                                            Classes="hint"
                                                            Text="{Binding DisplayText}"
                                                            TextWrapping="Wrap" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Diagnostics">
                <Border Classes="panel" Margin="0,10,0,0">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="section-title" Text="Diagnostics" />
                        <TextBlock
                            Classes="hint"
                            FontFamily="Consolas, Cascadia Mono"
                            Text="{Binding DiagnosticsText}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="About">
                <Border Classes="panel" Margin="0,10,0,0">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="section-title" Text="About" />
                        <Grid Classes="setting-row" ColumnDefinitions="210,*" ColumnSpacing="18">
                            <TextBlock Classes="label" VerticalAlignment="Center" Text="Version" />
                            <TextBlock Grid.Column="1" Classes="hint" VerticalAlignment="Center" Text="{Binding AppVersion}" />
                        </Grid>
                        <Grid Classes="setting-row" ColumnDefinitions="210,*" ColumnSpacing="18">
                            <TextBlock Classes="label" VerticalAlignment="Center" Text="Settings" />
                            <TextBlock
                                Grid.Column="1"
                                Classes="hint"
                                VerticalAlignment="Center"
                                Text="{Binding SettingsPath}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>

        <Grid
            Grid.Row="2"
            ColumnDefinitions="*,Auto,Auto"
            ColumnSpacing="10">
            <TextBlock
                Classes="hint"
                VerticalAlignment="Center"
                Foreground="{DynamicResource AccentBrush}"
                Text="{Binding StatusMessage}" />
            <Button
                x:Name="CancelButton"
                Grid.Column="1"
                Click="OnCancelClick"
                Content="Cancel"
                MinWidth="92" />
            <Button
                x:Name="SaveButton"
                Grid.Column="2"
                Classes="accent"
                Click="OnSaveClick"
                Content="Save"
                MinWidth="92" />
        </Grid>
    </Grid>
</Window>
